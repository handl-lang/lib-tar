--- internal octal helpers for tar header fields.
oct_int := (digits) ~> do {
  v := 0
  for c in char.chars(digits) { do {
    d := str.find("01234567", c)
    if d >= 0 { do { v := v * 8 + d } } else { do {} }
  } }
  v
}
int_oct := (n, width) ~> str.pad_left(octdx(n), width, "0")
octdx := (n) ~> do {
  s := ""
  v := n
  if v == 0 { do { s := "0" } } else { do {
    for _ in char.chars(str.repeat("x", 24)) { do {
      if v > 0 { do {
        s := char.at("01234567", v % 8) + s
        v := math.floor_div(v, 8)
      } } else { do {} }
    } }
  } }
  s
}

--- internal byte-level base64 over Bytes values — RFC 4648.
ALPHA := "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/"

emit4 := (n) ~> do {
  char.at(ALPHA, math.shr(n, 18))
    + char.at(ALPHA, math.bit_and(math.shr(n, 12), 63))
    + char.at(ALPHA, math.bit_and(math.shr(n, 6), 63))
    + char.at(ALPHA, math.bit_and(n, 63))
}

b64_enc_bytes := (bs) ~> do {
  acc := ""
  n := 0
  cnt := 0
  prev := 0
  last := 0
  for b in bytes.to_list(bs) { do {
    prev := last
    last := b
    if cnt == 0 { do { n := math.shl(b, 16) } } else {
      if cnt == 1 { do { n := math.bit_or(n, math.shl(b, 8)) } } else { do {
        n := math.bit_or(n, b)
        acc := acc + emit4(n)
        n := 0
      } }
    }
    cnt := if cnt == 2 { 0 } else { cnt + 1 }
  } }
  if cnt == 1 { do {
    acc := acc
      + char.at(ALPHA, math.shr(math.shl(last, 16), 18))
      + char.at(ALPHA, math.bit_and(math.shr(math.shl(last, 16), 12), 63))
      + "=="
  } } else {
    if cnt == 2 { do {
      m := math.bit_or(math.shl(prev, 16), math.shl(last, 8))
      acc := acc
        + char.at(ALPHA, math.shr(m, 18))
        + char.at(ALPHA, math.bit_and(math.shr(m, 12), 63))
        + char.at(ALPHA, math.bit_and(math.shr(m, 6), 63))
        + "="
    } } else { do {} }
  }
  acc
}

b64_dec_bytes := (s) ~> do {
  out := bytes.from_list([])
  q0 := 0
  q1 := 0
  q2 := 0
  cnt := 0
  for c in char.chars(s) { do {
    if c == "=" { do {} } else { do {
      v := str.find(ALPHA, c)
      if v < 0 { throw "b64: invalid digit" } else { do {} }
      if cnt == 0 { do { q0 := math.shl(v, 18) } } else {
        if cnt == 1 { do { q1 := math.shl(v, 12) } } else {
          if cnt == 2 { do { q2 := math.shl(v, 6) } } else { do {
            n := math.bit_or(math.bit_or(q0, q1), math.bit_or(q2, v))
            out := bytes.concat(out, bytes.from_list([
              math.bit_and(math.shr(n, 16), 255),
              math.bit_and(math.shr(n, 8), 255),
              math.bit_and(n, 255)]))
          } }
        }
      }
      cnt := if cnt == 3 { 0 } else { cnt + 1 }
    } }
  } }
  if cnt == 2 { do {
    out := bytes.concat(out, bytes.from_list([math.bit_and(math.shr(math.bit_or(q0, q1), 16), 255)]))
  } } else {
    if cnt == 3 { do {
      m := math.bit_or(math.bit_or(q0, q1), q2)
      out := bytes.concat(out, bytes.from_list([
        math.bit_and(math.shr(m, 16), 255),
        math.bit_and(math.shr(m, 8), 255)]))
    } } else { do {} }
  }
  out
}

--- internal tar header builder (POSIX ustar) — produces Bytes segments.

seg := (s) ~> bytes.utf8_encode(s)
zeros := (n) ~> do {
  z := []
  for _ in char.chars(str.repeat("x", n)) { do { z := [...z, 0] } }
  z
}
zeros512 := bytes.from_list(zeros(512))
zbytes := (n) ~> if n <= 0 { bytes.from_list([]) } else { bytes.slice(zeros512, 0, n) }
oct_field := (n, w) ~> do {
  s := str.pad_left(octdx(n), w - 1, "0")
  bytes.concat(seg(s), zbytes(w - bytes.len(seg(s))))
}
name_field := (p) ~> do {
  b := seg(p)
  if bytes.len(b) > 99 { do { b := bytes.slice(b, 0, 99) } } else { do {} }
  bytes.concat(b, zbytes(100 - bytes.len(b)))
}

header := (path, sz) ~> do {
  h := bytes.concat(
    bytes.concat(
      bytes.concat(name_field(path), oct_field(511, 8)),
      bytes.concat(oct_field(0, 8), oct_field(0, 8))
    ),
    bytes.concat(
      bytes.concat(oct_field(sz, 12), oct_field(0, 12)),
      bytes.concat(seg("        "), seg("0"))
    )
  )
  h := bytes.concat(
    bytes.concat(h, zbytes(100)),
    bytes.concat(
      bytes.concat(seg("ustar"), bytes.from_list([0])),
      bytes.concat(seg("00"), bytes.concat(seg("root"), zbytes(28)))
    )
  )
  h := bytes.concat(h, zbytes(32 + 8 + 8 + 155 + 12))
  s := 0
  for b in bytes.to_list(h) { do { s := s + b } }
  chk := bytes.concat(seg(str.pad_left(octdx(s), 6, "0")), bytes.from_list([0, 32]))
  bytes.concat(bytes.slice(h, 0, 148), bytes.concat(chk, bytes.slice(h, 156, 512 - 156)))
}

block := (n) ~> zbytes(n)

--- `tar.pack` — pure-Handl tar archive builder (POSIX ustar, Bytes-native).

pack := (entries) ~> do {
  out := bytes.from_list([])
  for e in entries { do {
    dat := b64_dec_bytes(e.contents)
    out := bytes.concat(out, header(e.path, bytes.len(dat)))
    out := bytes.concat(out, dat)
    pad := 512 - (bytes.len(dat) % 512)
    if pad < 512 { do { out := bytes.concat(out, block(pad)) } } else { do {} }
  } }
  out := bytes.concat(out, block(1024))
  b64_enc_bytes(out)
}

--- `tar.unpack` — pure-Handl tar archive reader (POSIX ustar, Bytes-native).

--- prefix length to first NUL in a bytes segment.
nzlen := (b) ~> do {
  k := 0
  hit := 0
  for x in bytes.to_list(b) { do {
    if hit == 0 {
      if x == 0 { do { hit := 1 } } else { do { k := k + 1 } }
    } else { do {} }
  } }
  k
}

unpack := (s) ~> do {
  bs := b64_dec_bytes(s)
  total := bytes.len(bs)
  entries := []
  off := 0
  done := false
  while { off: 0, done: false, entries: [] } {
    (off, done, entries) ~> if done || off >= total {
      { out: entries }
    } else {
      if bytes.at(bs, off) == 0 {
        { out: entries }
      } else {
        do {
          nb := bytes.slice(bs, off, 100)
          path := bytes.utf8_decode(bytes.slice(nb, 0, nzlen(nb)))
          sb := bytes.slice(bs, off + 124, 12)
          sz := oct_int(bytes.utf8_decode(bytes.slice(sb, 0, nzlen(sb))))
          dat := bytes.slice(bs, off + 512, sz)
          { state: {
            off: off + 512 + math.floor_div(sz + 511, 512) * 512,
            done: false,
            entries: [...entries, { path: path, contents: b64_enc_bytes(dat) }]
          } }
        }
      }
    }
  }
}

--- tar.pack -- pack an array of {path, contents} objects into a base64 tar archive string.
--- tar.unpack -- unpack a base64 tar archive string into an array of {path, contents} objects.
cap "tar.pack"
cap "tar.unpack"
op "tar.pack" : Array ~> String
  guarantee: IsBase64(output)
op "tar.unpack" : String ~> Array
  guarantee: True

--- pure-handl impls (the module arrows):
