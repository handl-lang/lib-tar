--- internal byte-level base64 over Bytes values — RFC 4648.
ALPHA := "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/"

emit4 := (n) ~> do {
  char.at(ALPHA, math.shr(n, 18))
    + char.at(ALPHA, math.bit_and(math.shr(n, 12), 63))
    + char.at(ALPHA, math.bit_and(math.shr(n, 6), 63))
    + char.at(ALPHA, math.bit_and(n, 63))
}

export b64_enc_bytes := (bs) ~> do {
  acc := ""
  n := 0
  cnt := 0
  prev := 0
  last := 0
  for b in bytes.to_list(bs) { do {
    prev := last
    last := b
    if cnt == 0 { do { n := math.shl(b, 16) } } else {
      if cnt == 1 { do { n := math.bit_or(n, math.shl(b, 8)) } } else { do {
        n := math.bit_or(n, b)
        acc := acc + emit4(n)
        n := 0
      } }
    }
    cnt := if cnt == 2 { 0 } else { cnt + 1 }
  } }
  if cnt == 1 { do {
    acc := acc
      + char.at(ALPHA, math.shr(math.shl(last, 16), 18))
      + char.at(ALPHA, math.bit_and(math.shr(math.shl(last, 16), 12), 63))
      + "=="
  } } else {
    if cnt == 2 { do {
      m := math.bit_or(math.shl(prev, 16), math.shl(last, 8))
      acc := acc
        + char.at(ALPHA, math.shr(m, 18))
        + char.at(ALPHA, math.bit_and(math.shr(m, 12), 63))
        + char.at(ALPHA, math.bit_and(math.shr(m, 6), 63))
        + "="
    } } else { do {} }
  }
  acc
}

export b64_dec_bytes := (s) ~> do {
  out := []
  q0 := 0
  q1 := 0
  q2 := 0
  cnt := 0
  for c in char.chars(s) { do {
    if c == "=" { do {} } else { do {
      v := str.find(ALPHA, c)
      if v < 0 { throw "b64: invalid digit" } else { do {} }
      if cnt == 0 { do { q0 := math.shl(v, 18) } } else {
        if cnt == 1 { do { q1 := math.shl(v, 12) } } else {
          if cnt == 2 { do { q2 := math.shl(v, 6) } } else { do {
            n := math.bit_or(math.bit_or(q0, q1), math.bit_or(q2, v))
            out := [...out,
              math.bit_and(math.shr(n, 16), 255),
              math.bit_and(math.shr(n, 8), 255),
              math.bit_and(n, 255)]
          } }
        }
      }
      cnt := if cnt == 3 { 0 } else { cnt + 1 }
    } }
  } }
  if cnt == 2 { do {
    out := [...out, math.bit_and(math.shr(math.bit_or(q0, q1), 16), 255)]
  } } else {
    if cnt == 3 { do {
      m := math.bit_or(math.bit_or(q0, q1), q2)
      out := [...out,
        math.bit_and(math.shr(m, 16), 255),
        math.bit_and(math.shr(m, 8), 255)]
    } } else { do {} }
  }
  bytes.from_list(out)
}
