--- internal list helpers — pure handl over plain lists.
export list_len := (xs) ~> do {
  n := 0
  for _ in xs { do { n := n + 1 } }
  n
}
export ix := (xs, i) ~> do {
  n := 0
  out := null
  for x in xs { do {
    if n == i { do { out := x } } else { do {} }
    n := n + 1
  } }
  out
}
export take := (xs, n) ~> do {
  out := []
  i := 0
  for x in xs { do {
    if i < n { do { out := [...out, x] } } else { do {} }
    i := i + 1
  } }
  out
}
export drop := (xs, n) ~> do {
  out := []
  i := 0
  for x in xs { do {
    if i >= n { do { out := [...out, x] } } else { do {} }
    i := i + 1
  } }
  out
}
export catx := (a, b) ~> [...a, ...b]
export zeros := (n) ~> do {
  out := []
  for _ in char.chars(str.repeat(" ", n)) { do { out := [...out, 0] } }
  out
}
export pad_to := (ns, w) ~> catx(ns, zeros(w - list_len(ns)))
export nz := (xs) ~> do {
  out := []
  hit := false
  for x in xs { do {
    if hit { do {} } else {
      if x == 0 { do { hit := true } } else { do { out := [...out, x] } }
    }
  } }
  out
}
export range := (n) ~> do {
  out := []
  i := 0
  for _ in char.chars(str.repeat("x", n)) { do {
    out := [...out, i]
    i := i + 1
  } }
  out
}
